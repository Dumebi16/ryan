{
  "framework": "vite",
  "installCommand": "npm ci",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/resources/:slug", "destination": "/api/og-post?slug=$slug" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/og-post.js": {
      "includeFiles": "dist/index.html"
    }
  }
}
