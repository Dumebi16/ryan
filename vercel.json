{
  "framework": "vite",
  "installCommand": "npm ci",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/", "destination": "/api/og-post?path=/" },
    { "source": "/about", "destination": "/api/og-post?path=/about" },
    { "source": "/sba-loan", "destination": "/api/og-post?path=/sba-loan" },
    { "source": "/business-acquisition", "destination": "/api/og-post?path=/business-acquisition" },
    { "source": "/strategic-financial-guidance", "destination": "/api/og-post?path=/strategic-financial-guidance" },
    { "source": "/contact", "destination": "/api/og-post?path=/contact" },
    { "source": "/resources", "destination": "/api/og-post?path=/resources" },
    { "source": "/resources/:slug", "destination": "/api/og-post" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/og-post.js": {
      "includeFiles": "dist/index.html"
    }
  }
}
